# My Audiobook Collection — the settings, read by systemd at every start.
#
# Copied to /etc/my-audiobook-collection.env on install and never overwritten
# afterwards, because it holds your password and your tokens. Edit it there, then
#   systemctl restart my-audiobook-collection
#
# These are the same settings the Docker image takes, under the same names: the
# Unraid template and this file are two spellings of one list.

# Where the database and the cover images live. On its own disk inside the
# container, not on the share: this is the one thing that cannot be rebuilt from
# the files, and `backups/` beside it is written here too.
DATA_DIR=/var/lib/my-audiobook-collection

# The port the app listens on.
PORT=8523

# Who the app writes as, and this is the setting that matters most.
#
# The service starts as root and drops to this user before it creates anything.
# Left empty it stays root, and every folder it makes on your share belongs to
# root — so you are refused permission to write in your own collection. Use the
# uid and gid that own the audiobooks: `stat -c '%u %g' /audiobooks` says which.
#
# 99:100 is nobody:users, which is what an Unraid share expects.
PUID=99
PGID=100

# The mode of what it creates. 022 makes it yours to write and everybody else's
# to read, which is the safe answer; 000 makes everything world-writable and is
# only for a share several machines write to.
UMASK=022

# The administrator: a name as well as a password. With both set, the listening
# page is shut to everybody else until you approve their account. Leave them
# empty and the app is open to anybody who can reach it on your network.
ADMIN_USER=
ADMIN_PASSWORD=

# Looking up missing metadata. Empty means that button says why it cannot.
GOOGLE_API_KEY=
# Which country's Google catalogue a fresh database starts on. Changed in
# Settings afterwards, and the setting wins; this only decides where it begins.
GOOGLE_COUNTRY=US

# Home Assistant: a token to require on /api/ha… Empty leaves those addresses
# open to anybody who can reach this app.
HA_TOKEN=

# Music Assistant: the password it logs in with. Empty means the Audiobookshelf
# face is not there at all.
MA_TOKEN=

# Only behind a reverse proxy: the address other machines reach this app on,
# when that is not the one they asked at.
BASE_URL=

# Behind a reverse proxy, the app believes X-Forwarded-For — which is what the
# sign-in backoff counts wrong guesses against. Set this to 0 if nothing in
# front of it sets that header, or anyone can spend somebody else's attempts.
# TRUST_PROXY=1

# Who may show the app inside a frame. Only this app, unless you embed it in a
# Home Assistant dashboard (a webpage card) — then add that address, quoted
# the way it is here.
# FRAME_ANCESTORS='self' http://192.168.2.200:8123

# Start even if it could not become PUID:PGID and is therefore still root.
# Everything it then creates on your share belongs to root. Only if you have
# read that sentence and want it anyway.
# ALLOW_ROOT=0
